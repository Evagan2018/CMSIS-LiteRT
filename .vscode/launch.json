{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Arm-FVP@GDB (launch)",
            "type": "gdbtarget",
            "request": "launch",
            "cwd": "${workspaceFolder}/",
            "program": "out/cmsis-litert/SSE-320-U85/Debug/cmsis-litert.axf",
            "gdb": "arm-none-eabi-gdb",
            "auxiliaryGdb": false,
            "initCommands": [
                "set remote verbose-resume-supported-packet off",
                "set remote verbose-resume-packet off",
                "tbreak main"
            ],
            "target": {
                "server": "${workspaceFolder}/.vscode/fvp.sh",
                "serverParameters": [
                    "-D",
                    "--plugin",
                    "${env:AVH_FVP_PLUGINS}/GDBServer.so",
                    "-C",
                    "GDBServer.port=3333",
                    "-f",
                    "board/Corstone-320/fvp_config.txt",
                    "--simlimit",
                    "60",
                    "-a",
                    "out/cmsis-litert/SSE-320-U85/Debug/cmsis-litert.hex"
                ],
                "port": "",
                "serverPortRegExp": "GDBServer: Listening .*port=([0-9]+)",
                "portDetectionTimeout": 300000
            },
            "cmsis": {
                "cbuildRunFile": "${command:cmsis-csolution.getCbuildRunFile}",
                "updateConfiguration": "manual"
                // Flip to "auto", run "Update Debug Tasks and Launch Configurations",
                // then reapply the target.server/serverParameters fields above.
            }
        },
        {
            "name": "Arm-FVP@GDB (attach)",
            "type": "gdbtarget",
            "request": "attach",
            "cwd": "${workspaceFolder}/",
            "program": "out/cmsis-litert/SSE-320-U85/Debug/cmsis-litert.axf",
            "gdb": "arm-none-eabi-gdb",
            "auxiliaryGdb": false,
            "initCommands": [
                "set remote verbose-resume-supported-packet off",
                "set remote verbose-resume-packet off"
            ],
            "target": {
                "port": "3333"
            },
            "cmsis": {
                "cbuildRunFile": "${command:cmsis-csolution.getCbuildRunFile}",
                "updateConfiguration": "auto"
            }
        }
    ]
}
